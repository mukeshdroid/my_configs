# Secrets / credentials — never commit these
.env
.env.*
*.env
*.secret
*.secrets
*.key
*.pem
.netrc
secrets/

# Local-only overrides (machine-specific tweaks you don't want in git).
# Pattern: name a file *.local or local.lua to keep it out of version control.
*.local
local.lua

# Editor cruft
*.swp
*.swo
.*.swp
.*.swo
*~
tags
.tags

# OS cruft
.DS_Store

# Backups (Makefile's install flow asks you to mv path path.bak)
*.bak
*.orig
